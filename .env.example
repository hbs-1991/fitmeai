# Anthropic — choose ONE:
# Option A: OAuth token from subscription (preferred, $0 cost)
# Run: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=
# Option B: API key (paid per token)
# ANTHROPIC_API_KEY=sk-ant-...

# Telegram Bot (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Owner Chat ID (restrict bot to single user, get via @userinfobot)
# OWNER_CHAT_ID=

# OpenAI (Whisper voice transcription only)
OPENAI_API_KEY=

# FatSecret API Credentials (get from https://platform.fatsecret.com/api).
# The platform page labels these "Consumer Key" and "Consumer Secret" — that is
# the OAuth 1.0 naming, and these are the names to prefer. FATSECRET_CLIENT_ID and
# FATSECRET_CLIENT_SECRET are accepted as aliases and take precedence if both are
# set (see config.py), so set ONE pair, not a mix of the two.
FATSECRET_CONSUMER_KEY=your_consumer_key_here
FATSECRET_CONSUMER_SECRET=your_consumer_secret_here

# OAuth Configuration
FATSECRET_OAUTH_CALLBACK_URL=http://localhost:8080/callback
FATSECRET_TOKEN_STORAGE=keyring

# FatSecret OAuth 1.0 tokens (for Docker — run: python export_tokens.py >> .env)
# FATSECRET_ACCESS_TOKEN=
# FATSECRET_ACCESS_SECRET=

# Server Configuration
LOG_LEVEL=INFO
LOG_FILE=fatsecret_mcp.log
